# Image used by the OTT runner to compile bots and to run them (one throw-away container each).
# Build:  python -m ott build-image    (or: docker build -f docker/Dockerfile.bot -t ott-bot-runner docker)
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp
USER 65534:65534
