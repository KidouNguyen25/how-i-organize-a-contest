{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.contest.uet.vnu.edu.vn/v2/competition_definition.json",
  "title": "CompetitionDefinition",
  "description": "Blueprint schema for a category of programming or bot tournament.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "definition_id",
    "version",
    "category",
    "name",
    "supported_adapters",
    "supported_runtimes",
    "config_schema"
  ],
  "properties": {
    "definition_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 3,
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "category": {
      "type": "string",
      "enum": ["TEST_SUITE_PROBLEM", "INTERACTIVE_BOT_MATCH", "CONTINUOUS_METRIC"]
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 2048
    },
    "supported_adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["adapter_id", "version_range"],
        "properties": {
          "adapter_id": { "type": "string" },
          "version_range": { "type": "string" }
        }
      }
    },
    "supported_runtimes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "config_schema": {
      "type": "object",
      "description": "JSON Schema validating season-specific configuration."
    }
  }
}
